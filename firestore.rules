rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() { return request.auth.token.email == 'munirshahzad044@gmail.com'; }
    function isDataOwner() { return request.auth != null && resource.data.tenantId == request.auth.uid; }

    match /users/{userId} {
      allow read, write: if isSuperAdmin();
      allow read: if request.auth.uid == userId;
      // A user may create/refresh only their OWN record, and only with tenantId == their uid.
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.tenantId == request.auth.uid;
    }
    match /{collection}/{docId} {
      allow read, write: if isSuperAdmin();
      allow read, update, delete: if isDataOwner();
      allow create: if request.auth != null && request.resource.data.tenantId == request.auth.uid;
    }
  }
}
